{
  "version": 2,
  "buildCommand": "cd webapp && npm install && npm run build",
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "webapp_dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/webhook",  "dest": "/api/webhook.py" },
    { "src": "/api/items",    "dest": "/api/items.py" },
    { "src": "/api/expenses", "dest": "/api/expenses.py" },
    { "src": "/api/notify",   "dest": "/api/notify.py" },
    { "src": "/api/settings", "dest": "/api/settings.py" },
    { "src": "/(.*)",         "dest": "/index.html" }
  ]
}