{
  "version": 2,
  "buildCommand": "cd webapp && npm install && npm run build",
  "outputDirectory": "webapp_dist",
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    { "source": "/api/webhook",  "destination": "/api/webhook.py" },
    { "source": "/api/items",    "destination": "/api/items.py" },
    { "source": "/api/expenses", "destination": "/api/expenses.py" },
    { "source": "/api/notify",   "destination": "/api/notify.py" },
    { "source": "/api/settings", "destination": "/api/settings.py" },
    { "source": "/(.*)",         "destination": "/index.html" }
  ]
}